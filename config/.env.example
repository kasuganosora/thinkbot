# =============================================================================
# thinkbot 配置文件示例
# 复制为 .env 并修改值。
#
# 注意：LLM 配置不在此文件中，请通过数据库设置。
#
# 优先级（从高到低）：
#   1. 运行时覆盖（代码 SetTemporary）
#   2. .env 文件
#   3. 数据库（config_settings 表）
#   4. 操作系统环境变量
#   5. 默认值
# =============================================================================

# --- 数据库 ---
db.path=thinkbot.db

# --- 日志 ---
log.level=debug

# --- LLM 配置（通过 Web UI 管理 Provider + 模型，不在此配置）---
# Provider 使用层级化管理：
#   1. 在 Web UI 创建 Provider（含 API Key、baseUrl）
#   2. 导入模型列表
#   3. 在 Bot 设置中选择主模型/轻量模型
#
# Bot 的 LLM 分配存储为：
#   bot.<id>.main   = <model-id>
#   bot.<id>.light  = <model-id>

# --- 集成测试 LLM 配置 ---
test.llm.api_key=your-api-key-here
test.llm.provider=bigmodel
test.llm.base_url=https://open.bigmodel.cn/api/coding/paas
test.llm.chat_path=/v4/chat/completions
test.llm.model=glm-5.2
test.llm.max_tokens=4096

# --- Bot 全局配置 ---
bot.system_prompt=You are a helpful assistant.
# bot.workers=4

# --- Channel 配置 ---
# 格式：channel.{name}.type, channel.{name}.token, channel.{name}.host

# Misskey
# channel.misskey-main.type=misskey
# channel.misskey-main.host=https://misskey.io
# channel.misskey-main.token=your-misskey-token

# Telegram
# channel.tg-main.type=telegram
# channel.tg-main.token=123456:ABC-DEF-your-telegram-token
