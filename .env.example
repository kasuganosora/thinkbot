# ThinkBot 配置示例（DooD 部署）
# 复制为 .env 后按需修改：cp .env.example .env

# 应用监听地址
api.addr=:8080

# 监听网卡：为空或 0.0.0.0 时对外暴露；仅本机访问建议设为 127.0.0.1
# api.addr=127.0.0.1:8080

# 允许跨域的来源（逗号分隔）；留空仅允许 localhost（开发模式）
# api.cors_origins=

# Cookie 是否仅经 HTTPS 传输（生产建议 true）
# api.cookie_secure=true

# SQLite 数据库文件路径（默认 data/thinkbot.db，落在持久化 data 卷）
# db.path=data/thinkbot.db

# 日志级别：debug / info / warn / error（默认 info）
# log.level=info


# 沙箱后端：DooD 部署必须为 docker
# （主程序容器内通过挂载的 docker.sock 指挥宿主 daemon 创建 bot 兄弟容器）
sandbox.backend=docker

# 沙箱镜像（per-bot 长期容器使用）
#   builtin  = thinkbot 内置浏览器沙箱镜像，由 thinkbot 在启动 bot 时按需自行构建
#              （含 chromium + patchright，构建上下文已打进二进制，更新 thinkbot 自动保持一致，无需手动 docker build）
#   <镜像名> = 任意已有镜像（如 alpine:latest、registry/thinkbot-bot:latest），作为预构建镜像原样使用，不经过自构建
# 留空等同于 builtin。
sandbox.image=builtin

# auto 模式下强制要求 Docker 可用：避免探测失败静默降级到 local 裸跑
# （显式 backend=docker 时本项无效，docker 不可用会直接报错）
sandbox.require_docker=true

# bot 工作空间根目录（主程序侧真实路径；SOUL.md 由主程序从 {dir}/{botID}/ 读取）
workspace.dir=data/workspaces

# 时区（影响 bot 时间感知与沙箱容器 TZ 环境变量）
system.timezone=Asia/Shanghai

# ============================================================================
# 自举 Loader（仅 selfhost 镜像 + 需显式开启；默认关闭，关闭时 loader 透明启动 thinkbot）
#
# 镜像构建：THINKBOT_TARGET=selfhost docker compose up -d --build（见 docker-compose.yml）
# 运行期开关：以下 loader.* 键控制 loader 行为。全部留空/注释 = 退化透传，零影响。
#
# loader.enabled=true            # 总开关：true 进入监管+自部署模式；false=透传
# loader.ops_addr=127.0.0.1:8090 # 运维 HTTP 监听（默认仅本机；远程暴露需自担风险）
# loader.token=                 # 【必填】变更类接口 Bearer Token；开启但为空则 loader 拒绝启动
# loader.health_addr=           # 子进程 /health URL；留空由 api.addr 自动推导
# loader.health_timeout=30s     # smoke test 健康判定截止
# loader.smoke_port=:18080      # 隔离 smoke test 端口（新二进制在独立端口验证，旧服务零中断）
# loader.build_timeout=600s     # 单次自部署总超时
# loader.git_dir=/app/src       # 自部署源码目录（selfhost 镜像内为全量仓）
# loader.crashloop_max=5        # 崩溃环阈值：窗口内连续崩溃超此数 → 自动回退上一良版本
# loader.crashloop_window=60s   # 崩溃环统计窗口
# ============================================================================
